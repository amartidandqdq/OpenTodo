    "Change server?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de serveur ?"
          }
        }
      }
    },
    "Changes that have not reached the server are lost. Your tasks stay on the server.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications qui n’ont pas encore atteint le serveur sont perdues. Vos tâches restent sur le serveur."
          }
        }
      }
    },
