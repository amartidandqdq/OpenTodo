    "Locked. Open OpenTodo to see your tasks.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé. Ouvrez OpenTodo pour voir vos tâches."
          }
        }
      }
    },
