    "description": {
     "en": "Moving is a project with a deadline and a lot of people involved. Start this template, then [share the project](https://open-todo.app/docs/sharing/) with everyone who is moving so each person can pick up tasks.\n\nThe sections follow the calendar, from six weeks before to after the move. Switch the project to a [board](https://open-todo.app/docs/sections-and-boards/) to see the stages side by side. Due dates count from the start day you pick, so adjust the first one and move the rest as needed."
    },
    "howToUse": [
     {
      "en": "Start the template, then share the project with everyone who is moving."
     },
     {
      "en": "Due dates count from the start day; set the moving day and move the rest to match."
     },
     {
      "en": "Switch the project to a board to see the stages side by side."
     }
    ],
    "makeItYours": [
     {
      "en": "Delete the tasks that do not apply (no pets, no car) and add the ones that do."
     },
     {
      "en": "Assign the admin tasks to one person and the packing to everyone."
     },
     {
      "en": "Add a label `@call` for the tasks that need a phone call during office hours."
     }
    ]
