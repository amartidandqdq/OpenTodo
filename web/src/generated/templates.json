     "en": "Trip planning"
    },
    "summary": {
     "en": "Bookings, documents and a packing list with subtasks, for a holiday or a work trip."
    },
    "description": {
     "en": "A trip has three phases: book, sort out the documents, pack. This template gives each a section and uses [subtasks](https://open-todo.app/docs/tasks-and-projects/) for the packing list, so you can tick items off on your phone while you pack.\n\nAdd a [reminder](https://open-todo.app/docs/reminders/) to the passport task if your trip is far away; renewals take time."
    },
    "howToUse": [
     {
      "en": "Start the template; the three sections are book, documents and pack."
     },
     {
      "en": "Add a reminder to the passport task if the trip is far away."
     },
     {
      "en": "Tick the packing subtasks off on your phone while you pack."
     }
    ],
    "makeItYours": [
     {
      "en": "Copy the packing list into a \"Standard packing\" project and reuse it for every trip."
     },
     {
      "en": "Share the project with your travel companions and split the bookings."
     },
     {
      "en": "Add the dates: flights, check-in, the day the insurance must be sorted."
     }
    ]
